#!/bin/sh
commit_msg=$(cat "$1")
pattern='^(feat|fix|chore|refactor|test|docs|perf|ci|build|revert)(\(.+\))?: .{1,100}$'
if ! echo "$commit_msg" | grep -qE "$pattern"; then
  echo "Erro: mensagem de commit fora do padrão Conventional Commits."
  echo "Exemplo: feat(hero): adiciona seção hero com CTA"
  exit 1
fi
